<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Connecting to BlogIt...</title>
  <link rel="stylesheet" href="/styles/main.css" />
</head>
<body>
  <div class="loading-page">
    <main class="loading-panel" aria-live="polite">
      <div class="loading-brand">BlogIt</div>
      <div class="loader" aria-hidden="true"></div>
      <h1>Connecting to your blog dashboard</h1>
      <p>The API server is starting up. BlogIt will open automatically as soon as the connection is ready.</p>

      <div class="loading-status">
        <span class="status-dot" aria-hidden="true"></span>
        <span id="retry-message">Checking connection...</span>
      </div>

      <div class="loading-progress" aria-hidden="true">
        <span></span>
      </div>
    </main>
  </div>

  <script>
    let retryCount = 0;

    async function checkServer() {
      const retryMessage = document.getElementById("retry-message");
      retryCount += 1;
      retryMessage.textContent = `Checking connection... attempt ${retryCount}`;

      try {
        const response = await fetch(`/status?t=${Date.now()}`, {
          cache: "no-store",
        });
        const data = await response.json();

        if (response.ok && data.ready) {
          window.location.href = "/";
        } else {
          retryMessage.textContent = data.message || "Still connecting. Retrying automatically...";
          setTimeout(checkServer, 5000);
        }
      } catch (error) {
        retryMessage.textContent = "Connection unavailable. Retrying...";
        setTimeout(checkServer, 5000);
      }
    }

    setTimeout(checkServer, 1000);
  </script>
</body>
</html>
